<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>ef510d57-0c48-4dc5-9048-6652f2a767c4</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="AspNetCore.SassCompiler" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Blazor.Component.Shared/Blazor.Component.Shared.csproj" />
    <ProjectReference Include="../Blazor.Hybrid.Shared/Blazor.Hybrid.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- SCSS 源码仅用于编译，不作为静态资源发布 -->
    <Content Remove="wwwroot\scss\**" />
    <None Include="sasscompiler.json" />
  </ItemGroup>

</Project>
